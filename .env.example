# Template only. Copy to ignored .env.local for the lightweight local room server.
# Fill secrets locally; never commit the completed file or show it in recordings.
# Run: node --env-file=.env.local server.mjs
# Production needs these same names in its SERVER runtime/secret settings.

# Public identifier for your registered Confidential Twitch application.
TWITCH_CLIENT_ID=replace_with_your_twitch_client_id

# Server-only: obtain from the same Twitch application's Developer Console.
TWITCH_CLIENT_SECRET=replace_locally_with_your_twitch_client_secret

# Server-only: generate a random 32-byte value, encoded as exactly 64 hex digits.
# Keep stable across restarts/deploys. Changing it requires users to reconnect.
TWITCH_TOKEN_KEY=replace_locally_with_64_random_hex_characters

# Canonical origin only: no path, query or fragment. Register origin + /teams.
# The lightweight local server uses localhost and PORT (4173 by default).
TWITCH_APP_ORIGIN=http://localhost:4173

# Optional local port. If changed, register the corresponding localhost callback.
# PORT=4173
